# Public: safe to expose to the browser. The frontend calls these directly;
# Postgres Row Level Security (see sql/schema.sql) is what actually protects
# every row behind them -- these URLs alone grant no access to other users' data.
# Get the real values from the Neon Console: Auth -> Configuration (Auth URL)
# and Postgres database -> Data API (API URL).
NEXT_PUBLIC_NEON_AUTH_URL=https://ep-your-endpoint.neonauth.REGION.aws.neon.tech/neondb/auth
NEXT_PUBLIC_NEON_DATA_API_URL=https://ep-your-endpoint.apirest.REGION.aws.neon.tech/neondb/rest/v1

# Server-only secrets -- NEVER commit real values, never prefix with NEXT_PUBLIC_.
# This app's architecture (browser -> Data API, RLS-protected) does not use
# a direct Postgres connection or a server-side auth session, so these are
# not required. They're listed for reference in case you add server-side
# tooling (migrations, admin scripts) later.
# DATABASE_URL=postgresql://user:password@host/dbname
# NEON_AUTH_BASE_URL=
# NEON_AUTH_COOKIE_SECRET=
